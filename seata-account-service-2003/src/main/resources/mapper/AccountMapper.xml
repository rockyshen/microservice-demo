        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.rockyshen.mapper.AccountMapper">

    <resultMap id="BaseResultMap" type="com.rockyshen.model.Account">
            <id property="id" column="id" />
